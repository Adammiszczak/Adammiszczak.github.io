{% assign locale_key = page.lang | default: 'en' %}
{% assign copy = site.data.site_copy[locale_key] %}
{% assign routes = site.data.locale_routes[locale_key] %}
{% assign posts = site.posts | where: "lang", locale_key | sort: "date" | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ locale_key }}">
  <title>{{ site.brand_name | xml_escape }} — {{ copy.feed_name | xml_escape }}</title>
  <subtitle>{{ copy.tagline | xml_escape }}</subtitle>
  <id>{{ site.url }}{{ site.baseurl }}{{ routes.feed }}</id>
  <link href="{{ site.url }}{{ site.baseurl }}{{ routes.feed }}" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}{{ routes.home }}" rel="alternate" type="text/html" />
  <updated>{% if posts.first %}{{ posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.url }}{{ site.baseurl }}{{ routes.about }}</uri>
  </author>
  <generator uri="https://jekyllrb.com/">Jekyll</generator>
  {% for post in posts %}
  <entry>
    <title>{{ post.title | strip_html | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary type="text">{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
